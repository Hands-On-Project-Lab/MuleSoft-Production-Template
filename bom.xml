		<!-- ===================== EXCHANGE / PROJECT ARTIFACTS ===================== -->
		<!-- Org that owns the shared API assets (AnyAirline training org). Replace with YOUR org id when you host your own assets. -->
		<aa.ap.orgid>a63e6d25-8aaf-4512-b36d-d91b90a55c4a</aa.ap.orgid>
		<aa.exchange.repo.id>anypoint-exchange-${aa.ap.orgid}</aa.exchange.repo.id>

		<!-- Your own org id (also the groupId of this BOM). Used for publishing to YOUR Exchange. -->
		<student.deployment.ap.orgid>713ed815-e409-4a51-9ef2-7a71017fa06e</student.deployment.ap.orgid>

