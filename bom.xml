		<secure.conf.prop.module.version>1.2.3</secure.conf.prop.module.version>
		<validation.module.version>2.0.1</validation.module.version>
		<json.module.version>2.1.6</json.module.version>
		<xml.module.version>1.3.3</xml.module.version>
		<oauth.module.version>1.1.18</oauth.module.version>
		<munit.dbserver.module.version>2.0.4</munit.dbserver.module.version>
		<db.connector.version>1.13.2</db.connector.version>
		<objectstore.connector.version>1.2.1</objectstore.connector.version>
		<wsc.connector.version>1.6.11</wsc.connector.version>
		<vm.connector.version>2.0.0</vm.connector.version>
		<anypoint.mq.connector.version>3.1.7</anypoint.mq.connector.version>
		<sftp.connector.version>1.4.1</sftp.connector.version>
		<file.connector.version>1.3.4</file.connector.version>
		<email.connector.version>1.6.0</email.connector.version>
