	<!-- Repository order matters. Put anypoint-exchange-v3 first so dependency resolution uses Exchange credentials. -->
	<repositories>
		<repository>
			<!-- MUST stay FIRST: Handles artifact resolution and downloads using Exchange credentials -->
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
		</repository>
		<repository>
			<!-- Org-scoped Exchange repo of the org that owns the shared API assets. Needs its own <server> entry. -->
			<id>${aa.exchange.repo.id}</id>
			<name>AnyAirline Anypoint Exchange</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
		</repository>
		<repository>
			<!-- Public MuleSoft artifacts, no auth -->
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>https://repository.mulesoft.org/nexus/repository/releases/</url>
		</repository>
		<repository>
			<!-- Mule EE artifacts: requires MuleSoft-issued Nexus credentials (server id must be releases-ee) -->
			<id>releases-ee</id>
			<name>Mule Release Repository</name>
			<url>https://repository.mulesoft.org/nexus/content/repositories/releases-ee/</url>
		</repository>
		<repository>
			<!-- Deployment-only server moved down so it is not used for general artifact resolution -->
			<id>anypoint-deploy-server</id>
			<name>Anypoint Exchange (your org, used for deployment)</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
		</repository>
	</repositories>
	<pluginRepositories>
