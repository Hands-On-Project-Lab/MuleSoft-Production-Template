<?xml version="1.0" encoding="UTF-8"?>
<!--
	============================================================================
	bom.xml  -  LEVEL 1 of 3  (version catalogue: "which versions may I use?")
	============================================================================
	Inheritance chain:   pom.xml (the app)  ->  parent-pom.xml  ->  bom.xml
	  * bom.xml         : ONLY versions (properties + dependencyManagement + pluginManagement).
	                      It never adds a dependency or plugin to a project by itself.
	  * parent-pom.xml  : build behaviour (resource filtering, enforcer, deploy profiles).
	  * pom.xml         : the app itself (which dependencies it actually uses).

	Legend used in the comments below:
	  [VERIFIED]   checked against docs.mulesoft.com release notes in Sep 2026
	  [UNVERIFIED] carried over from your sample - open Exchange (or run
	               mvn versions:display-dependency-updates -Pversions) and pick the
	               latest patch that lists your Mule runtime + Java 17 as compatible.

	LICENCE NOTE: the original sample header says this file is Creative Commons
	BY-NC-ND (NonCommercial, NoDerivatives) training material. Do not reuse a
	modified copy of that file in a commercial/production repo. Treat this version
	as YOUR OWN company BOM: keep it in your own repo and put your own header here.

	IMPORTANT: publish this file and parent-pom.xml to your own Exchange (or a Maven
	repo) for real teams, then remove <relativePath> from the children so every app
	resolves the SAME released BOM version instead of a local file.
	============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- groupId MUST be your Anypoint ORGANIZATION ID (hard-coded, not a property) or Exchange rejects the publish -->
	<groupId>713ed815-e409-4a51-9ef2-7a71017fa06e</groupId>
	<artifactId>solutions-bom</artifactId>
	<name>solutions-bom</name>

	<!-- Exchange needs a NON-SNAPSHOT version to publish. Bump on every change (semver). -->
	<version>1.0.0</version>
	<packaging>pom</packaging>

	<properties>
		<!-- Needed so Exchange can classify the asset type when this BOM is published -->
		<type>custom</type>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- ===================== TOOLCHAIN ===================== -->
		<!-- Java 17: Mule 4.9+ runs applications on Java 17 only [VERIFIED]. Build with a JDK 17, not a JRE. -->
		<java.version>17</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<maven.compiler.release>${java.version}</maven.compiler.release>

		<!-- Maven: Mule Maven Plugin 4.10.0 supports Maven 3.9.0 to 3.9.15 [VERIFIED]. Maven 3.8 and Maven 4 are NOT supported. -->
		<maven.min.version>3.9.0</maven.min.version>
		<maven.max.version>3.10.0</maven.max.version>

		<!-- ===================== GENERIC MAVEN PLUGINS ===================== -->
		<clean.plugin.version>3.2.0</clean.plugin.version>
		<!-- Keep deploy plugin downgraded (documented incompatibility with Exchange facade: AGW-4370) -->
		<deploy.plugin.version>2.8.2</deploy.plugin.version>
		<install.plugin.version>2.5.2</install.plugin.version>
		<dependency.plugin.version>3.3.0</dependency.plugin.version>
		<site.plugin.version>3.12.0</site.plugin.version>
		<resources.plugin.version>3.3.1</resources.plugin.version>
		<versions.plugin.version>2.10.0</versions.plugin.version>
		<release.plugin.version>3.0.0-M5</release.plugin.version>
		<!-- Enforcer bumped 3.0.0 -> 3.5.0 (needed for requireJavaVersion + Maven 3.9 rules); [UNVERIFIED] against MuleSoft docs but standard Apache plugin -->
		<enforcer.plugin.version>3.5.0</enforcer.plugin.version>
		<license.plugin.version>2.0.0</license.plugin.version>
		<xml.format.plugin.version>3.2.1</xml.format.plugin.version>
		<google.replacer.plugin.version>1.5.3</google.replacer.plugin.version>

		<!-- ===================== MULE RUNTIME ===================== -->
		<!-- Mule 4.9 = LTS (standard support to Aug 6 2027, extended to Feb 6 2028) [VERIFIED].
		     Do NOT use Edge (4.10/4.11/4.12) for production: Edge support windows are only ~5 months. -->
		<!-- 4.9.21 came from your sample: confirm it is the latest 4.9.x patch in Runtime Manager before go-live [UNVERIFIED] -->
		<app.runtime>4.9.21</app.runtime>
		<app.runtime.server>4.9.21</app.runtime.server>
		<!-- With Mule Maven Plugin >= 4.1.0 the runtime is plain semver + releaseChannel + javaVersion (see parent-pom).
		     The old "4.9.21:4" suffix format belongs to the pre-4.5 version schema. -->
		<cloudhub.runtime.version>${app.runtime.server}</cloudhub.runtime.version>

		<!-- Mule Maven Plugin 4.10.0 (Jun 2026): Java 8/11/17/21, Maven 3.9.0-3.9.15, builds for runtimes up to 4.12 [VERIFIED] -->
		<mule.maven.plugin.version>4.9.1</mule.maven.plugin.version>
		<mule.extensions.maven.plugin.version>1.5.0-20220221</mule.extensions.maven.plugin.version>
		<munit.extensions.maven.plugin.version>1.1.2</munit.extensions.maven.plugin.version>
		<exchange.mule.maven.plugin.version>0.0.17</exchange.mule.maven.plugin.version>

		<!-- MUnit 3.7.4 (Sep 1 2026): Maven 3.9.0-3.9.15, Java 8/11/17/21 [VERIFIED].
		     Mule 4.9 requires MUnit >= 3.6.3. Your sample had 2.3.10 which predates Java 17 support (added in MUnit 3.1.0) -->
		<munit.version>3.7.4</munit.version>
		<weave.version>1.1.2</weave.version>

