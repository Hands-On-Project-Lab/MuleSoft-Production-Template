		<apikit.version>1.12.5</apikit.version>
		<!-- HTTP 1.11.3 [VERIFIED]. Do NOT use 1.11.2: deprecated, malformed POM caused a duplicate-package build failure with the Sockets connector -->
		<http.connector.version>1.12.1</http.connector.version>
		<!-- Sockets 1.2.9 (Jul 23 2026) [VERIFIED] -->
		<sockets.connector.version>1.2.9</sockets.connector.version>

