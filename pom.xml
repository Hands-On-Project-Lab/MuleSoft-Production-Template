<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>713ed815-e409-4a51-9ef2-7a71017fa06e</groupId>
		<artifactId>solutions-parent-pom</artifactId>
		<version>1.0.0</version>
		<relativePath>./parent-pom.xml</relativePath>
	</parent>

	<groupId>713ed815-e409-4a51-9ef2-7a71017fa06e</groupId>
	<artifactId>check-in-papi-impl</artifactId>
	<version>1.0.0</version>
	
	<!-- In MuleSoft (Mule 4) projects, 
	     the <packaging> element in pom.xml determines how Maven builds, packages, and resolves artifacts:
		
		 mule-application: 
		 - The default packaging type for standard Mule applications. 
		 - It compiles flows, resources, and dependencies into a lightweight runnable application JAR.
		 
		 
		 mule-domain: 
		 - Used for Mule Domain Projects. 
		 - Domain projects bundle shared resources (like HTTP Listener configurations, DB connection pools, or TLS certificates) across multiple Mule applications running on the same Mule runtime.

		mule-domain-bundle: 
		- Used when you need to package multiple mule-domain projects into a single bundle artifact for centralized deployment.

		mule-policy: 
		- Used for developing custom API Gateway policies that can be uploaded to Anypoint Exchange and applied via API Manager.
		
		jar: 
		- Used for standard Java libraries, custom Mule Java modules, custom connectors (built via Mule SDK), or DataWeave module libraries.
		
		pom: 
		- Used for Parent POMs or Bill of Materials (BOM) projects to centralize dependency versions, plugins, repositories, and build profiles across multiple Mule apps.
	-->
	<packaging>mule-application</packaging>

	<name>check-in-papi</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<app.runtime>4.9.21</app.runtime>
		<mule.maven.plugin.version>4.10.0</mule.maven.plugin.version>
		<api.groupId>713ed815-e409-4a51-9ef2-7a71017fa06e</api.groupId>
		<api.artifactId>check-in-papi</api.artifactId>
		<api.version>1.0.0</api.version>
		<munit.coverage.required>0</munit.coverage.required>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<extensions>true</extensions>
			</plugin>
			<!-- Unit tests + coverage report. Runs in the test phase, so a failing test blocks packaging and deployment. -->
			<plugin>
				<groupId>com.mulesoft.munit.tools</groupId>
				<artifactId>munit-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>test</id>
						<phase>test</phase>
						<goals>
							<goal>test</goal>
							<goal>coverage-report</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<coverage>
						<runCoverage>true</runCoverage>
						<failBuild>true</failBuild>
						<requiredApplicationCoverage>${munit.coverage.required}</requiredApplicationCoverage>
						<formats>
							<format>html</format>
						</formats>
					</coverage>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-http-connector</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-sockets-connector</artifactId>
			<classifier>mule-plugin</classifier>
		</dependency>
		<dependency>
			<groupId>${api.groupId}</groupId>
			<artifactId>${api.artifactId}</artifactId>
			<version>${api.version}</version>
			<classifier>oas</classifier>
			<type>zip</type>
		</dependency>
		<dependency>
			<groupId>org.mule.modules</groupId>
			<artifactId>mule-apikit-module</artifactId>
			<version>1.12.5</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		<!-- Test-only: the classifier + scope test keeps MUnit out of the deployable jar -->
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-runner</artifactId>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-tools</artifactId>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.mulesoft.modules</groupId>
			<artifactId>mule-secure-configuration-property-module</artifactId>
			<version>1.3.2</version>
			<classifier>mule-plugin</classifier>
		</dependency>
	</dependencies>

</project>
